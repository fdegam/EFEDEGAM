# Credentials and local configuration: never commit real values.
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Development dependencies and generated checks.
node_modules/
.venv/
__pycache__/
*.py[cod]
.artifacts/
.DS_Store

# Original Blender sources stay private, outside public web assets.
*.blend
*.blend1
*.blend2

# Intermediate bake output (float lightmaps, panoramas); only the encoded
# WebP files in assets/models/lightmaps/ are published.
tools/.bake/
*.exr
*.npy
